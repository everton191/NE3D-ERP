{
  "name": "simplifica-3d",
  "version": "0.1.0",
  "private": true,
  "description": "Simplifica 3D para gestao de pedidos, caixa e impressao 3D.",
  "scripts": {
    "build": "npm run build:web",
    "vercel-build": "npm run build:web",
    "build:web": "node scripts/prepare-web.js",
    "supabase:help": "supabase --help",
    "supabase:login": "supabase login",
    "supabase:link": "supabase link --project-ref qsufnnivlgdidmjuaprb",
    "supabase:advisors": "supabase db advisors --linked --type all --level warn",
    "supabase:lint": "supabase db lint --linked",
    "supabase:migrations": "supabase migration list --linked",
    "supabase:test:db": "supabase test db --linked",
    "supabase:test:rest": "node scripts/test-supabase-rest.js",
    "supabase:test:telemetry": "node scripts/test-telemetry-rest.js",
    "supabase:test:migrations": "node scripts/check-supabase-migrations.js",
    "supabase:emails:dry-run": "node scripts/apply-supabase-email-templates.js --dry-run",
    "supabase:emails:get": "node scripts/apply-supabase-email-templates.js --get",
    "supabase:emails:apply": "node scripts/apply-supabase-email-templates.js",
    "supabase:staging:status": "node scripts/supabase-staging.js status",
    "supabase:staging:create": "node scripts/supabase-staging.js create",
    "supabase:staging:link": "node scripts/supabase-staging.js link",
    "supabase:staging:push": "node scripts/supabase-staging.js push",
    "supabase:staging:apply-admin": "node scripts/supabase-staging.js apply-admin",
    "supabase:staging:seed": "node scripts/supabase-staging.js seed",
    "supabase:production:status": "node scripts/storefront-production-controlled.js status",
    "supabase:production:backup": "node scripts/storefront-production-controlled.js backup",
    "supabase:production:apply-storefront": "node scripts/storefront-production-controlled.js apply",
    "supabase:production:apply-storefront-admin": "node scripts/storefront-production-controlled.js apply-admin",
    "test:auth-hotfix": "node scripts/test-auth-hotfix.js",
    "test:auth-ui": "node scripts/test-auth-ui.js",
    "test:calculator-fee": "node scripts/test-calculator-extra-fee.js",
    "test:storefront-phase3": "node scripts/test-storefront-phase3.js",
    "test:storefront-phase35": "node scripts/test-storefront-phase35.js",
    "test:storefront-phase3-5": "node scripts/test-storefront-phase35.js",
    "test:storefront-rls-simulation": "node scripts/test-storefront-rls-simulation.js",
    "test:storefront-staging": "node scripts/test-storefront-staging.js",
    "test:storefront-production-controlled": "node scripts/test-storefront-production-controlled.js",
    "test:erp-cash-fiscal-foundation": "node scripts/test-erp-cash-fiscal-foundation.js",
    "test:monetization": "node scripts/test-monetization.js",
    "android:add": "npm run build:web && cap add android",
    "android:sync": "npm run build:web && cap sync android",
    "android:open": "npm run android:sync && cap open android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug && cd .. && npm run android:apk:copy",
    "android:apk:copy": "node scripts/copy-android-apk.js"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor/android": "^8.3.1",
    "@capacitor/core": "^8.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.1",
    "supabase": "^2.98.0"
  }
}
