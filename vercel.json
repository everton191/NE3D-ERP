{
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/loja/(.*)",
      "dest": "/"
    },
    {
      "src": "/store-admin/(.*)",
      "dest": "/"
    },
    {
      "src": "/src/integrations/(.*)",
      "status": 404
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/"
    }
  ]
}
